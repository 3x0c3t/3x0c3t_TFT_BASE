#include <Arduino.h>

#include "config.h"
#include "display.h"
#include "splash.h"
#include "wifi.h"
#include "weather.h"
#include "clock.h"
#include "pages.h"
#include "settings.h"

// ============================================================
// SETUP
// ============================================================

void setup()
{
    Serial.begin(115200);

    delay(500);

    Serial.println();
    Serial.println("================================");
    Serial.println("[BOOT] DEMARRAGE");
    Serial.println("================================");

    // ========================================================
    // INITIALISATION TFT
    // ========================================================

    displayInit();

    // ========================================================
    // SPLASH SCREEN
    // ========================================================

    Serial.println(
        "[SPLASH] DEMARRAGE"
    );

    splashShow();

    Serial.println(
        "[SPLASH] TERMINE"
    );

    // ========================================================
    // INITIALISATION DES PAGES
    // ========================================================

    pagesInit();

    settingsInit();

    // ========================================================
    // HORLOGE
    // ========================================================

    clockInit();

    // ========================================================
    // WIFI
    // ========================================================

    wifiInit();

    // ========================================================
    // METEO
    // ========================================================

    weatherInit();

    // ========================================================
    // INTERFACE
    // ========================================================

    pagesShow(
        PAGE_HOME
    );

    Serial.println();
    Serial.println(
        "[BOOT] Initialisation terminee"
    );
}

// ============================================================
// LOOP
// ============================================================

void loop()
{
    wifiUpdate();

    clockUpdate();

    weatherUpdate();

    drawHeaderTime();

    delay(1000);
}